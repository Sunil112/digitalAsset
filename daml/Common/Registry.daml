module Common.Registry where

-- Registry contracts for participants, asset directories, and permission management.
-- Participant tracks registration and active state.
-- AssetDirectory and AssetPermission manage asset enablement and holder/issuer authorization.

import Daml.Script
import DA.List(filter)

-- Participant stores participant registration info and active state.
template Participant
  with
    admin : Party
    participant : Party
    active : Bool
  where
    signatory admin
    observer participant

    choice Activate : ContractId Participant
      controller admin
      do
        create this with active = True

    choice Deactivate : ContractId Participant
      controller admin
      do
        create this with active = False

-- AssetDirectory tracks asset registration, enablement status, and viewer permissions.
template AssetDirectory
  with
    admin : Party
    assetId : Text
    enabled : Bool
    viewers : [Party]
  where
    signatory admin
    observer viewers

    choice RegisterAsset : ContractId AssetDirectory
      controller admin
      do
        create this with enabled = False

    choice EnableAsset : ContractId AssetDirectory
      controller admin
      do
        create this with enabled = True

    choice DisableAsset : ContractId AssetDirectory
      controller admin
      do
        create this with enabled = False

-- AssetPermission controls which holders and issuers are authorized for an asset.
template AssetPermission
  with
    admin : Party
    assetId : Text
    allowedHolders : [Party]
    allowedIssuers : [Party]
    viewers : [Party]
  where
    signatory admin
    observer allowedHolders, allowedIssuers, viewers

    choice AllowHolder : ContractId AssetPermission
      with
        holder : Party
      controller admin
      do
        create this with allowedHolders = holder :: allowedHolders

    choice BlockHolder : ContractId AssetPermission
      with
        holder : Party
      controller admin
      do
        create this with allowedHolders = filter (/= holder) allowedHolders

    choice AllowIssuer : ContractId AssetPermission
      with
        issuer : Party
      controller admin
      do
        create this with allowedIssuers = issuer :: allowedIssuers

    choice RevokeIssuer : ContractId AssetPermission
      with
        issuer : Party
      controller admin
      do
        create this with allowedIssuers = filter (/= issuer) allowedIssuers
